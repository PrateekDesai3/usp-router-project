from tr181_data import TR181_SAMPLE_DATA
class TR181Model:
    def __init__(self):
        self.data = TR181_SAMPLE_DATA
    # ==========================================================
    # NORMALIZE PATH
    # ==========================================================
    def normalize_path(self, path):
        path = path.strip()
        if path.endswith("."):
            path = path[:-1]
        if not path.startswith("Device"):
            path = "Device." + path
        return path
    # ==========================================================
    # SPLIT PATH
    # ==========================================================
    def _split_path(self, path):
        path = self.normalize_path(path)
        parts = path.split(".")
        # Remove Device because self.data already starts at Device
        if parts[0] == "Device":
            parts = parts[1:]
        return parts
    # ==========================================================
    # GET NODE
    # ==========================================================
    def _get_node(self, path):
        path = self.normalize_path(path)
        if path == "Device":
            return self.data["Device"]
        parts = self._split_path(path)
        node = self.data["Device"]
        for part in parts:
            # Dictionary
            if isinstance(node, dict):
                if part not in node:
                    raise KeyError(
                        f"Parameter not found: {path}"
                    )
                node = node[part]
            # List / table instance
            elif isinstance(node, list):
                if not part.isdigit():
                    raise KeyError(
                        f"Expected instance number in path: {path}"
                    )
                index = int(part) - 1
                if index < 0 or index >= len(node):
                    raise KeyError(
                        f"Instance {part} not found: {path}"
                    )
                node = node[index]
            else:
                raise KeyError(
                    f"Cannot continue through parameter: {path}"
                )
        return node
    # ==========================================================
    # GET PARAMETER
    # ==========================================================
    def get_parameter(self, path):
        return self._get_node(path)
    # ==========================================================
    # SET PARAMETER
    # ==========================================================
    def set_parameter(self, path, value):
        path = self.normalize_path(path)
        if path == "Device":
            raise ValueError(
                "Device cannot be SET directly"
            )
        parts = self._split_path(path)
        node = self.data["Device"]
        for part in parts[:-1]:
            if isinstance(node, dict):
                if part not in node:
                    raise KeyError(
                        f"Parameter not found: {path}"
                    )
                node = node[part]
            elif isinstance(node, list):
                if not part.isdigit():
                    raise KeyError(
                        f"Invalid instance: {part}"
                    )
                index = int(part) - 1
                if index < 0 or index >= len(node):
                    raise KeyError(
                        f"Instance not found: {part}"
                    )
                node = node[index]
            else:
                raise KeyError(
                    f"Cannot traverse parameter: {path}"
                )
        last = parts[-1]
        if isinstance(node, dict):
            if last not in node:
                raise KeyError(
                    f"Parameter not found: {path}"
                )
            old_value = node[last]
            node[last] = value
            return old_value
        elif isinstance(node, list):
            if not last.isdigit():
                raise KeyError(
                    f"Invalid list index: {last}"
                )
            index = int(last) - 1
            if index < 0 or index >= len(node):
                raise KeyError(
                    f"Instance not found: {last}"
                )
            old_value = node[index]
            node[index] = value
            return old_value
        raise KeyError(
            f"Cannot SET parameter: {path}"
        )
    # ==========================================================
    # GET ALL TR-181 PARAMETERS
    # ==========================================================
    def get_all_parameters(self):
        result = {}
        def walk(node, path):
            # Dictionary/object
            if isinstance(node, dict):
                for key, value in node.items():
                    child_path = (
                        f"{path}.{key}"
                    )
                    walk(
                        value,
                        child_path
                    )
            # Table/object instances
            elif isinstance(node, list):
                for index, value in enumerate(
                    node,
                    start=1
                ):
                    child_path = (
                        f"{path}.{index}"
                    )
                    walk(
                        value,
                        child_path
                    )
            # Actual parameter value
            else:
                result[path] = node
        walk(
            self.data["Device"],
            "Device"
        )
        return result
    # ==========================================================
    # GET COMPLETE OBJECT
    # ==========================================================
    def get_model(self):
        return self.data

